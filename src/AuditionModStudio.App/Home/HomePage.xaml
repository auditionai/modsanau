<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuditionModStudio.App.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            x:Name="ResponsiveLayout"
            MaxWidth="1120"
            Padding="{StaticResource AmsShellContentPadding}"
            HorizontalAlignment="Stretch"
            ColumnSpacing="{StaticResource AmsSpace16}"
            RowSpacing="{StaticResource AmsSpace16}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowHomeState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SecondColumn.Width" Value="0" />
                            <Setter Target="ModStepCard.(Grid.Column)" Value="0" />
                            <Setter Target="ModStepCard.(Grid.Row)" Value="2" />
                            <Setter Target="ProjectStepCard.(Grid.Row)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideHomeState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="860" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SecondColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8" Spacing="{StaticResource AmsSpace8}">
                <TextBlock
                    x:Name="HomeHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource AmsSectionTitleStyle}"
                    Text="Create an Audition mod project" />
                <TextBlock
                    Style="{StaticResource AmsBodyTextStyle}"
                    Text="Start with the game. Audition AI Mod Studio will only show compatible Mod Types and will select the trusted archive workflow for you." />
            </StackPanel>

            <Border
                x:Name="GameStepCard"
                Grid.Row="1"
                Style="{StaticResource AmsCardStyle}">
                <StackPanel Spacing="{StaticResource AmsSpace12}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                        <Border Style="{StaticResource AmsStatusBadgeStyle}">
                            <TextBlock Text="1" />
                        </Border>
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Choose game" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Game" />
                    <ComboBox
                        x:Name="GamePicker"
                        AutomationProperties.Name="Game"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{x:Bind ViewModel.CanSelectGame, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Games}"
                        PlaceholderText="Choose a game"
                        SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ModStepCard"
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource AmsCardStyle}">
                <StackPanel Spacing="{StaticResource AmsSpace12}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                        <Border Style="{StaticResource AmsStatusBadgeStyle}">
                            <TextBlock Text="2" />
                        </Border>
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Choose Mod Type" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Compatible Mod Type" />
                    <ComboBox
                        x:Name="ModPicker"
                        AutomationProperties.Name="Compatible Mod Type"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{x:Bind ViewModel.CanSelectMod, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.CompatibleMods, Mode=OneWay}"
                        PlaceholderText="Choose a compatible Mod Type"
                        SelectedItem="{x:Bind ViewModel.SelectedMod, Mode=TwoWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource AmsBodyTextStyle}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ProjectStepCard"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Style="{StaticResource AmsGamingPanelStyle}">
                <Grid ColumnSpacing="{StaticResource AmsSpace16}" RowSpacing="{StaticResource AmsSpace12}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                        <Border Style="{StaticResource AmsStatusBadgeStyle}">
                            <TextBlock Text="3" />
                        </Border>
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Create project" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="{StaticResource AmsSpace8}">
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Project name" />
                        <TextBox
                            x:Name="ProjectNameInput"
                            AutomationProperties.Name="Project name"
                            Header="Project name"
                            IsEnabled="{x:Bind ViewModel.IsCreating, Mode=OneWay, Converter={StaticResource InvertedBooleanConverter}}"
                            MaxLength="128"
                            PlaceholderText="Example: Audition Login Refresh"
                            Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource AmsBodyTextStyle}"
                            Text="{x:Bind ViewModel.ProjectNameValidationMessage, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="{StaticResource AmsSpace8}">
                        <Button
                            AutomationProperties.Name="Cancel project creation"
                            Click="OnCancelClicked"
                            IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                            Style="{StaticResource AmsSecondaryButtonStyle}">
                            Cancel
                        </Button>
                        <Button
                            AutomationProperties.Name="Create project"
                            Click="OnCreateClicked"
                            IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                            Style="{StaticResource AmsPrimaryButtonStyle}">
                            Create project
                        </Button>
                    </StackPanel>

                    <ProgressBar
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        AutomationProperties.Name="Project creation progress"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
