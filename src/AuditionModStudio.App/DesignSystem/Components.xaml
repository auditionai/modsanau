<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AmsGamingPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AmsPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AmsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AmsRadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource AmsPanelPadding}" />
    </Style>

    <Style x:Key="AmsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AmsCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AmsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AmsRadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource AmsCardPadding}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow />
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AmsAccentCardStyle"
        BasedOn="{StaticResource AmsCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AmsAccentGradientBrush}" />
    </Style>

    <ControlTemplate x:Key="AmsDepthButtonTemplate" TargetType="Button">
        <Grid>
            <Border
                Margin="0,3,0,0"
                Background="{TemplateBinding BorderBrush}"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                x:Name="Surface"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SurfaceTransform" />
                </Border.RenderTransform>
                <Grid>
                    <Border
                        x:Name="HoverOverlay"
                        Background="{ThemeResource AmsButtonHoverOverlayBrush}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}" />
                </Grid>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0.18"
                                Duration="{StaticResource AmsMotionFast}" />
                            <DoubleAnimation
                                Storyboard.TargetName="SurfaceTransform"
                                Storyboard.TargetProperty="TranslateY"
                                To="-1"
                                Duration="{StaticResource AmsMotionFast}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="SurfaceTransform"
                                Storyboard.TargetProperty="TranslateY"
                                To="2"
                                Duration="{StaticResource AmsMotionPress}" />
                            <DoubleAnimation
                                Storyboard.TargetName="SurfaceTransform"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.985"
                                Duration="{StaticResource AmsMotionPress}" />
                            <DoubleAnimation
                                Storyboard.TargetName="SurfaceTransform"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.985"
                                Duration="{StaticResource AmsMotionPress}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Surface.Opacity" Value="0.48" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="AmsPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AmsButtonPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AmsButtonPrimaryDepthBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AmsButtonContentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource AmsRadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource AmsFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AmsTypeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="{StaticResource AmsButtonPadding}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AmsFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource AmsFocusThickness}" />
        <Setter Property="Template" Value="{StaticResource AmsDepthButtonTemplate}" />
    </Style>

    <Style
        x:Key="AmsSecondaryButtonStyle"
        BasedOn="{StaticResource AmsPrimaryButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AmsButtonSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AmsButtonSecondaryDepthBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AmsTextPrimaryBrush}" />
    </Style>

    <Style x:Key="AmsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AmsTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AmsFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AmsTypeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AmsBodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AmsTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AmsFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AmsTypeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AmsStatusBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AmsCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AmsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AmsRadiusPill}" />
        <Setter Property="Padding" Value="{StaticResource AmsStatusBadgePadding}" />
    </Style>
</ResourceDictionary>
