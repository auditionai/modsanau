<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color primitives: raw values only; components never consume these directly. -->
    <Color x:Key="AmsIndigo400">#FF818CF8</Color>
    <Color x:Key="AmsIndigo500">#FF6366F1</Color>
    <Color x:Key="AmsIndigo600">#FF4F46E5</Color>
    <Color x:Key="AmsCyan400">#FF22D3EE</Color>
    <Color x:Key="AmsPink400">#FFF472B6</Color>
    <Color x:Key="AmsGreen400">#FF4ADE80</Color>
    <Color x:Key="AmsAmber400">#FFFBBF24</Color>
    <Color x:Key="AmsRed400">#FFF87171</Color>
    <Color x:Key="AmsSlate950">#FF080B14</Color>
    <Color x:Key="AmsSlate900">#FF111827</Color>
    <Color x:Key="AmsSlate800">#FF1F2937</Color>
    <Color x:Key="AmsSlate700">#FF374151</Color>
    <Color x:Key="AmsSlate400">#FF94A3B8</Color>
    <Color x:Key="AmsSlate200">#FFE2E8F0</Color>
    <Color x:Key="AmsSlate100">#FFF1F5F9</Color>
    <Color x:Key="AmsWhite">#FFFFFFFF</Color>
    <Color x:Key="AmsBlack">#FF000000</Color>

    <!-- 4 px spacing rhythm. -->
    <x:Double x:Key="AmsSpace4">4</x:Double>
    <x:Double x:Key="AmsSpace8">8</x:Double>
    <x:Double x:Key="AmsSpace12">12</x:Double>
    <x:Double x:Key="AmsSpace16">16</x:Double>
    <x:Double x:Key="AmsSpace24">24</x:Double>
    <x:Double x:Key="AmsSpace32">32</x:Double>
    <Thickness x:Key="AmsPrimitiveControlPadding">16,10</Thickness>
    <Thickness x:Key="AmsPrimitiveCardPadding">20</Thickness>
    <Thickness x:Key="AmsPrimitiveBadgePadding">10,4</Thickness>
    <Thickness x:Key="AmsPrimitiveFocusThickness">2</Thickness>

    <!-- Shape, typography and motion primitives. -->
    <CornerRadius x:Key="AmsRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="AmsRadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="AmsRadiusLarge">18</CornerRadius>
    <CornerRadius x:Key="AmsRadiusPill">999</CornerRadius>
    <x:Double x:Key="AmsTypeCaption">12</x:Double>
    <x:Double x:Key="AmsTypeBody">14</x:Double>
    <x:Double x:Key="AmsTypeTitle">20</x:Double>
    <x:Double x:Key="AmsTypeDisplay">32</x:Double>
    <FontFamily x:Key="AmsFontFamily">Segoe UI Variable Text</FontFamily>
    <Duration x:Key="AmsMotionFast">0:0:0.12</Duration>
    <Duration x:Key="AmsMotionPress">0:0:0.08</Duration>
</ResourceDictionary>
