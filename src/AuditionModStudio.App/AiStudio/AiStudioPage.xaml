<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuditionModStudio.App.AiStudio.AiStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="{StaticResource AmsShellContentPadding}" RowSpacing="{StaticResource AmsSpace16}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="{StaticResource AmsSpace8}">
                <TextBlock
                    x:Name="StudioHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource AmsSectionTitleStyle}"
                    Text="AI Studio" />
                <TextBlock
                    Style="{StaticResource AmsBodyTextStyle}"
                    Text="Create a preview through trusted services. Nothing is applied to the project automatically." />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                    <ProgressRing
                        AutomationProperties.Name="AI Studio loading"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource AmsBodyTextStyle}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <Grid
                Grid.Row="1"
                ColumnSpacing="{StaticResource AmsSpace16}"
                RowSpacing="{StaticResource AmsSpace16}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="StackedStudioState">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ControlsColumn.Width" Value="0" />
                                <Setter Target="StudioControls.(Grid.Column)" Value="0" />
                                <Setter Target="StudioControls.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="WideStudioState">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition x:Name="ControlsColumn" Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border MinHeight="420" Style="{StaticResource AmsGamingPanelStyle}">
                    <Grid RowSpacing="{StaticResource AmsSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource AmsSectionTitleStyle}"
                            Text="Generated preview" />
                        <Grid Grid.Row="1" MinHeight="320">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource AmsBodyTextStyle}"
                                Text="The completed AI result will appear here as an InternalImage preview."
                                TextAlignment="Center" />
                            <Image
                                x:Name="PreviewImage"
                                AutomationProperties.Name="AI generated preview"
                                MaxHeight="560"
                                Stretch="Uniform" />
                        </Grid>
                        <ProgressBar
                            Grid.Row="2"
                            AutomationProperties.Name="AI request progress"
                            Maximum="100"
                            Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border
                    x:Name="StudioControls"
                    Grid.Column="1"
                    Style="{StaticResource AmsCardStyle}">
                    <StackPanel Spacing="{StaticResource AmsSpace12}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource AmsSectionTitleStyle}"
                            Text="Request" />
                        <ComboBox
                            Header="Operation"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.Operations}"
                            MinHeight="44"
                            SelectedItem="{x:Bind ViewModel.SelectedOperation, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.OperationDescription, Mode=OneWay}" />
                        <TextBox
                            AcceptsReturn="True"
                            Header="Prompt"
                            MaxLength="4000"
                            MinHeight="96"
                            PlaceholderText="Describe the image or requested edit"
                            Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.PromptValidationMessage, Mode=OneWay}" />
                        <TextBox
                            AcceptsReturn="True"
                            Header="Negative prompt (optional)"
                            MaxLength="4000"
                            MinHeight="72"
                            PlaceholderText="Describe what to avoid"
                            Text="{x:Bind ViewModel.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.NegativePromptValidationMessage, Mode=OneWay}" />
                        <Grid ColumnSpacing="{StaticResource AmsSpace8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Header="Model preference"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind ViewModel.Models}"
                                MinHeight="44"
                                SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Column="1"
                                Header="Quality"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind ViewModel.Qualities}"
                                MinHeight="44"
                                SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
                        </Grid>
                        <ComboBox
                            Header="Aspect ratio"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.Aspects}"
                            MinHeight="44"
                            SelectedItem="{x:Bind ViewModel.SelectedAspect, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.ReferenceMessage, Mode=OneWay}" />
                        <Border Style="{StaticResource AmsStatusBadgeStyle}">
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource AmsBodyTextStyle}"
                                Text="{x:Bind ViewModel.QuoteText, Mode=OneWay}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                            <Button
                                AutomationProperties.Name="Submit AI preview request"
                                Click="OnSubmitClicked"
                                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                                MinHeight="44"
                                Style="{StaticResource AmsPrimaryButtonStyle}">
                                Create preview
                            </Button>
                            <Button
                                AutomationProperties.Name="Cancel current AI request"
                                Click="OnCancelClicked"
                                IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                                MinHeight="44"
                                Style="{StaticResource AmsSecondaryButtonStyle}">
                                Cancel
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource AmsGamingPanelStyle}">
                <StackPanel Spacing="{StaticResource AmsSpace12}">
                    <Grid ColumnSpacing="{StaticResource AmsSpace8}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource AmsSectionTitleStyle}"
                                Text="Job history" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource AmsBodyTextStyle}"
                                Text="{x:Bind ViewModel.HistoryMessage, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Refresh AI job history"
                            Click="OnRefreshHistoryClicked"
                            MinHeight="44"
                            Style="{StaticResource AmsSecondaryButtonStyle}">
                            Refresh
                        </Button>
                    </Grid>
                    <ListView
                        AutomationProperties.Name="AI job history"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="52" Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Operation}" />
                                        <TextBlock Text="{Binding CreatedAt}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding State}" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Cancel server AI job"
                                        Click="OnCancelJobClicked"
                                        IsEnabled="{Binding CanCancel}"
                                        MinHeight="44"
                                        Style="{StaticResource AmsSecondaryButtonStyle}"
                                        Tag="{Binding JobId}">
                                        Cancel job
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
