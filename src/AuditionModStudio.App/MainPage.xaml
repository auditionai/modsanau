<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AuditionModStudio.App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource AmsShellBackgroundBrush}">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCommandPaletteInvoked" />
    </Page.KeyboardAccelerators>
    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="False"
        Background="{ThemeResource AmsShellBackgroundBrush}"
        HorizontalContentAlignment="Stretch"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Top"
        SelectionChanged="OnNavigationSelectionChanged"
        VerticalContentAlignment="Stretch">
        <NavigationView.PaneHeader>
            <Grid MinHeight="52" Padding="20,0,16,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="4" Height="28" VerticalAlignment="Center" Background="{ThemeResource AmsButtonPrimaryBrush}" CornerRadius="2" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource AmsTextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" Text="KHÔNG GIAN SÁNG TẠO" />
            </Grid>
        </NavigationView.PaneHeader>
        <Grid x:Name="ShellRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Border Padding="24,10" Background="{ThemeResource AmsPanelBrush}" BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="4" Height="30" Background="{ThemeResource AmsAccentSecondaryBrush}" CornerRadius="2" />
                        <StackPanel><TextBlock AutomationProperties.HeadingLevel="Level1" FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" /><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.CurrentDescription, Mode=OneWay}" /></StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" AutomationProperties.Name="Mở bảng lệnh" Click="OnCommandPaletteClicked" Style="{StaticResource AmsSecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontSize="15" Glyph="&#xE945;" /><TextBlock Text="Lệnh nhanh" /><Border Padding="7,3" Background="{ThemeResource AmsSurfaceLowBrush}" CornerRadius="4"><TextBlock FontFamily="Cascadia Mono" FontSize="11" Text="Ctrl K" /></Border></StackPanel></Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ContentControl x:Name="HomeContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="WorkspaceContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="AiStudioContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="ImageEditorContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="AccountContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="SettingsContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <Border x:Name="PlaceholderContent" Margin="32,24" Style="{StaticResource AmsGamingPanelStyle}">
                    <StackPanel Padding="{StaticResource AmsShellContentPadding}" Spacing="{StaticResource AmsSpace12}">
                        <TextBlock x:Name="ContentHeading" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource AmsSectionTitleStyle}" Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.CurrentDescription, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="ActivityDrawer" Grid.Row="2" MaxHeight="250" Padding="20,12" Background="{ThemeResource AmsPanelBrush}" BorderBrush="{ThemeResource AmsStrongBorderBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Foreground="{ThemeResource AmsFocusBrush}" Glyph="&#xE9D9;" /><TextBlock FontWeight="SemiBold" Text="Nhật ký tác vụ" /><Border Style="{StaticResource AmsStatusBadgeStyle}"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Tối đa 100 sự kiện" /></Border></StackPanel><TextBox x:Name="ActivitySearch" Grid.Column="1" AutomationProperties.Name="Tìm trong nhật ký tác vụ" PlaceholderText="Tìm sự kiện" TextChanged="OnActivitySearchChanged" /><ToggleSwitch x:Name="AutoScrollToggle" Grid.Column="2" AutomationProperties.Name="Tự cuộn nhật ký" Header="Tự cuộn" IsOn="True" /><Button Grid.Column="3" AutomationProperties.Name="Đóng nhật ký tác vụ" Click="OnToggleActivityClicked" Style="{StaticResource AmsGhostButtonStyle}"><FontIcon Glyph="&#xE711;" /></Button></Grid>
                    <ListView x:Name="ActivityList" Grid.Row="1" AutomationProperties.Name="Danh sách sự kiện tác vụ" IsItemClickEnabled="False" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><Grid MinHeight="36" Padding="8,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="22" /><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="12" Text="{Binding Time}" /><FontIcon Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding Brush}" FontSize="13" Glyph="{Binding Glyph}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Severity}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Message}" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Row="3" Padding="16,0" Background="{ThemeResource AmsStatusBarBrush}" BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Foreground="{ThemeResource AmsSuccessBrush}" FontSize="11" Glyph="&#xE73E;" /><TextBlock VerticalAlignment="Center" FontSize="12" Text="Sẵn sàng" /><TextBlock VerticalAlignment="Center" Foreground="{ThemeResource AmsTextMutedBrush}" Text="•" /><TextBlock VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" /><TextBlock VerticalAlignment="Center" Foreground="{ThemeResource AmsTextMutedBrush}" Text="•" /><TextBlock VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" /></StackPanel><Button Grid.Column="1" MinHeight="28" Padding="10,2" AutomationProperties.Name="Nhật ký tác vụ" Click="OnToggleActivityClicked" Style="{StaticResource AmsGhostButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontSize="12" Glyph="&#xE9D9;" /><TextBlock FontSize="12" Text="Nhật ký tác vụ" /><TextBlock x:Name="ActivityCountText" FontFamily="Cascadia Mono" FontSize="11" Text="0" /></StackPanel></Button></Grid>
            </Border>

            <Border x:Name="CommandPalette" Grid.RowSpan="4" Width="620" MaxHeight="520" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" Background="{ThemeResource AmsPanelBrush}" BorderBrush="{ThemeResource AmsStrongBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AmsRadiusLarge}" Visibility="Collapsed">
                <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" Foreground="{ThemeResource AmsFocusBrush}" Glyph="&#xE721;" /><TextBlock Grid.Column="1" FontSize="20" FontWeight="SemiBold" Text="Bảng lệnh" /><Button Grid.Column="2" AutomationProperties.Name="Đóng bảng lệnh" Click="OnCloseCommandPaletteClicked" Style="{StaticResource AmsGhostButtonStyle}"><FontIcon Glyph="&#xE711;" /></Button></Grid><TextBox x:Name="CommandSearch" Grid.Row="1" AutomationProperties.Name="Tìm lệnh" PlaceholderText="Nhập tên trang hoặc thao tác…" TextChanged="OnCommandSearchChanged" /><ListView x:Name="CommandList" Grid.Row="2" AutomationProperties.Name="Các lệnh có sẵn" IsItemClickEnabled="True" ItemClick="OnCommandItemClicked" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Grid MinHeight="48" Padding="10,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" Foreground="{ThemeResource AmsFocusBrush}" Glyph="{Binding Glyph}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{Binding Label}" /><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{Binding Description}" /></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Cascadia Mono" Style="{StaticResource AmsCaptionTextStyle}" Text="Enter" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>
            </Border>
            <InfoBar x:Name="NotificationBar" Grid.RowSpan="4" Width="460" Margin="0,18,24,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsClosable="True" IsOpen="False" Severity="Success" />
        </Grid>
    </NavigationView>
</Page>
