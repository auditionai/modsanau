<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuditionModStudio.App.Account.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.Name="Account profile and credit history">
        <Grid MaxWidth="1200" Padding="{StaticResource AmsShellContentPadding}" RowSpacing="{StaticResource AmsSpace16}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="{StaticResource AmsSpace12}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource AmsSpace8}">
                    <TextBlock
                        x:Name="AccountHeading"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource AmsSectionTitleStyle}"
                        Text="Account" />
                    <TextBlock
                        Style="{StaticResource AmsBodyTextStyle}"
                        Text="Server-verified profile, wallet, usage and recent credit transactions. This page is read-only." />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                        <ProgressRing
                            AutomationProperties.Name="Loading account data"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource AmsBodyTextStyle}"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.HelpText="Reload profile, wallet, usage and transaction history from the trusted server"
                    AutomationProperties.Name="Refresh account data"
                    Click="OnRefreshClicked"
                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                    MinHeight="44"
                    Style="{StaticResource AmsSecondaryButtonStyle}">Refresh</Button>
            </Grid>

            <InfoBar
                x:Name="AccountError"
                Grid.Row="1"
                x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Warning"
                Title="Account data unavailable" />

            <StackPanel x:Name="AccountSnapshot" Grid.Row="2" x:Load="{x:Bind ViewModel.ShowProfile, Mode=OneWay}" Spacing="{StaticResource AmsSpace16}">
                <Grid x:Name="AccountCards" ColumnSpacing="{StaticResource AmsSpace16}" RowSpacing="{StaticResource AmsSpace16}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="StackedAccountCards">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="SecondAccountColumn.Width" Value="0" />
                                    <Setter Target="WalletCard.(Grid.Column)" Value="0" />
                                    <Setter Target="WalletCard.(Grid.Row)" Value="1" />
                                    <Setter Target="UsageCard.(Grid.Row)" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideAccountCards">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="840" /></VisualState.StateTriggers>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SecondAccountColumn" Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource AmsGamingPanelStyle}">
                        <StackPanel Spacing="{StaticResource AmsSpace8}">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Profile" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Display name" />
                            <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Email" />
                            <TextBlock Text="{x:Bind ViewModel.Email, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="User ID" />
                            <TextBlock Text="{x:Bind ViewModel.UserId, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="WalletCard" Grid.Column="1" Style="{StaticResource AmsAccentCardStyle}">
                        <StackPanel Spacing="{StaticResource AmsSpace8}">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Wallet" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Available credits" />
                            <TextBlock FontSize="32" FontWeight="SemiBold" Text="{x:Bind ViewModel.AvailableCredits, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Reserved credits" />
                            <TextBlock FontSize="22" Text="{x:Bind ViewModel.ReservedCredits, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Server snapshot" />
                            <TextBlock Text="{x:Bind ViewModel.ObservedAt, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="UsageCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource AmsCardStyle}">
                        <Grid ColumnSpacing="{StaticResource AmsSpace16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Lifetime granted" /><TextBlock FontSize="22" Text="{x:Bind ViewModel.CreditsGranted, Mode=OneWay}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Lifetime used" /><TextBlock FontSize="22" Text="{x:Bind ViewModel.CreditsUsed, Mode=OneWay}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Transactions" /><TextBlock FontSize="22" Text="{x:Bind ViewModel.TransactionCount, Mode=OneWay}" /></StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <Border x:Name="AccountHistory" Grid.Row="3" x:Load="{x:Bind ViewModel.ShowHistory, Mode=OneWay}" Style="{StaticResource AmsGamingPanelStyle}">
                <StackPanel Spacing="{StaticResource AmsSpace12}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Recent credit transactions" />
                    <ListView
                        AutomationProperties.Name="Recent credit transaction history"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="72" Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Kind}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Amount}" />
                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding BalanceChange}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{Binding BalanceAfter}" /></StackPanel>
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding CreatedAt}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border x:Name="EmptyAccountHistory" Grid.Row="3" x:Load="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" Style="{StaticResource AmsGamingPanelStyle}">
                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource AmsSpace8}">
                    <FontIcon Glyph="&#xE8C7;" FontSize="28" />
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="No credit transactions" TextAlignment="Center" />
                    <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Your server wallet is ready. Verified transactions will appear here." TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
