<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuditionModStudio.App.Account.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
    <ScrollViewer AutomationProperties.Name="Hồ sơ tài khoản và lịch sử Credits" HorizontalContentAlignment="Stretch">
        <Grid Padding="{StaticResource AmsShellContentPadding}" RowSpacing="{StaticResource AmsSpace20}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="{StaticResource AmsSpace12}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource AmsSpace8}">
                    <TextBlock
                        x:Name="AccountHeading"
                        x:Uid="AccountHeading"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource AmsPageTitleStyle}"
                        Text="Tài khoản" />
                    <TextBlock
                        Style="{StaticResource AmsBodyTextStyle}"
                        Text="Quản lý hồ sơ, Credits và hoạt động gần đây." />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                        <ProgressRing
                            AutomationProperties.Name="Đang tải dữ liệu tài khoản"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource AmsBodyTextStyle}"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.HelpText="Tải lại hồ sơ, số dư Credits và lịch sử giao dịch"
                    AutomationProperties.Name="Làm mới dữ liệu tài khoản"
                    Click="OnRefreshClicked"
                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                    MinHeight="44"
                    Style="{StaticResource AmsSecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE72C;" /><TextBlock Text="Làm mới" /></StackPanel></Button>
            </Grid>

            <InfoBar
                x:Name="AccountError"
                Grid.Row="1"
                x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Warning"
                Title="Dịch vụ tài khoản đang tạm thời gián đoạn" />

            <Grid x:Name="OfflineAccount" Grid.Row="2" x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}" ColumnSpacing="{StaticResource AmsSpace16}" RowSpacing="{StaticResource AmsSpace16}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.RowSpan="2" MinHeight="360" Style="{StaticResource AmsAccentCardStyle}"><StackPanel VerticalAlignment="Center" Spacing="{StaticResource AmsSpace16}"><Border Width="64" Height="64" Background="{ThemeResource AmsPanelBrush}" BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="1" CornerRadius="8"><FontIcon Foreground="{ThemeResource AmsFocusBrush}" FontSize="28" Glyph="&#xE77B;" /></Border><TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsPageTitleStyle}" Text="Tài khoản của bạn" /><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Thông tin tài khoản sẽ xuất hiện khi kết nối được khôi phục. Các công cụ chỉnh sửa cục bộ vẫn sẵn sàng." /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource AmsGamingPanelStyle}"><StackPanel Spacing="{StaticResource AmsSpace16}"><FontIcon HorizontalAlignment="Left" Foreground="{ThemeResource AmsTextMutedBrush}" FontSize="24" Glyph="&#xE8C7;" /><TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Credits" /><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Chưa thể tải số dư và mức sử dụng Credits lúc này." /><Border Margin="0,12,0,0" Style="{StaticResource AmsStatusBadgeStyle}"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="CHƯA KẾT NỐI" /></Border></StackPanel></Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AmsGamingPanelStyle}"><StackPanel Spacing="{StaticResource AmsSpace16}"><FontIcon HorizontalAlignment="Left" Foreground="{ThemeResource AmsTextMutedBrush}" FontSize="24" Glyph="&#xE823;" /><TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Hoạt động gần đây" /><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Các giao dịch Credits đã hoàn tất sẽ xuất hiện tại đây." /><TextBlock Margin="0,12,0,0" Style="{StaticResource AmsCaptionTextStyle}" Text="Chưa có dữ liệu" /></StackPanel></Border>
            </Grid>

            <StackPanel x:Name="AccountSnapshot" Grid.Row="2" x:Load="{x:Bind ViewModel.ShowProfile, Mode=OneWay}" Spacing="{StaticResource AmsSpace16}">
                <Border Style="{StaticResource AmsAccentCardStyle}"><Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="4"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Mã thiết bị" /><TextBlock AutomationProperties.Name="Mã thiết bị công khai" FontFamily="Consolas" FontSize="20" Text="{x:Bind ViewModel.DeviceCode, Mode=OneWay}" /></StackPanel>
                    <Button Grid.Column="1" HorizontalAlignment="Right" MinHeight="44" Click="OnCopyDeviceCodeClicked" Style="{StaticResource AmsSecondaryButtonStyle}" Content="Sao chép mã" />
                    <StackPanel Grid.Row="1" Spacing="8"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Gói sử dụng" /><TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="{x:Bind ViewModel.SubscriptionStatus, Mode=OneWay}" /><TextBlock Text="{x:Bind ViewModel.SubscriptionExpiry, Mode=OneWay}" /><TextBlock Text="{x:Bind ViewModel.RemainingDays, Mode=OneWay}" /><Button MinHeight="44" HorizontalAlignment="Left" Click="OnRenewClicked" Style="{StaticResource AmsPrimaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8AB;" /><TextBlock Text="Gia hạn" /></StackPanel></Button></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8"><TextBlock TextWrapping="Wrap" Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.Benefits, Mode=OneWay}" /><Button MinHeight="44" HorizontalAlignment="Left" Click="OnBuyCreditsClicked" Style="{StaticResource AmsSecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C7;" /><TextBlock Text="Mua Credits" /></StackPanel></Button></StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Mã quà tặng" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox AutomationProperties.Name="Nhập mã quà tặng" Header="Mã quà tặng" MaxLength="128" Text="{x:Bind ViewModel.GiftCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" VerticalAlignment="Bottom" MinHeight="44" IsEnabled="{x:Bind ViewModel.CanRedeem, Mode=OneWay}" Click="OnRedeemGiftCodeClicked" Style="{StaticResource AmsPrimaryButtonStyle}" Content="Kích hoạt" /></Grid></StackPanel>
                </Grid></Border>
                <Grid x:Name="AccountCards" ColumnSpacing="{StaticResource AmsSpace16}" RowSpacing="{StaticResource AmsSpace16}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="StackedAccountCards">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="SecondAccountColumn.Width" Value="0" />
                                    <Setter Target="WalletCard.(Grid.Column)" Value="0" />
                                    <Setter Target="WalletCard.(Grid.Row)" Value="1" />
                                    <Setter Target="UsageCard.(Grid.Row)" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideAccountCards">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="840" /></VisualState.StateTriggers>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SecondAccountColumn" Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource AmsGamingPanelStyle}">
                        <StackPanel Spacing="{StaticResource AmsSpace8}">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Hồ sơ" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Tên hiển thị" />
                            <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Email" />
                            <TextBlock Text="{x:Bind ViewModel.Email, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Mã người dùng" />
                            <TextBlock Text="{x:Bind ViewModel.UserId, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="WalletCard" Grid.Column="1" Style="{StaticResource AmsAccentCardStyle}">
                        <StackPanel Spacing="{StaticResource AmsSpace8}">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Số dư Credits" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Credits khả dụng" />
                            <TextBlock FontSize="32" FontWeight="SemiBold" Text="{x:Bind ViewModel.AvailableCredits, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Credits đang giữ" />
                            <TextBlock FontSize="22" Text="{x:Bind ViewModel.ReservedCredits, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Cập nhật lúc" />
                            <TextBlock Text="{x:Bind ViewModel.ObservedAt, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="UsageCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource AmsCardStyle}">
                        <Grid ColumnSpacing="{StaticResource AmsSpace16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Tổng Credits đã nhận" /><TextBlock FontSize="22" Text="{x:Bind ViewModel.CreditsGranted, Mode=OneWay}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Tổng Credits đã dùng" /><TextBlock FontSize="22" Text="{x:Bind ViewModel.CreditsUsed, Mode=OneWay}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Giao dịch" /><TextBlock FontSize="22" Text="{x:Bind ViewModel.TransactionCount, Mode=OneWay}" /></StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <Border x:Name="AccountHistory" Grid.Row="3" x:Load="{x:Bind ViewModel.ShowHistory, Mode=OneWay}" Style="{StaticResource AmsGamingPanelStyle}">
                <StackPanel Spacing="{StaticResource AmsSpace12}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Giao dịch Credits gần đây" />
                    <ListView
                        AutomationProperties.Name="Lịch sử giao dịch Credits gần đây"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="72" Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Kind}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Amount}" />
                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding BalanceChange}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{Binding BalanceAfter}" /></StackPanel>
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding CreatedAt}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border x:Name="EmptyAccountHistory" Grid.Row="3" x:Load="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" Style="{StaticResource AmsGamingPanelStyle}">
                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource AmsSpace8}">
                    <FontIcon Glyph="&#xE8C7;" FontSize="28" />
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Chưa có giao dịch Credits" TextAlignment="Center" />
                    <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Các giao dịch đã xác minh sẽ xuất hiện tại đây." TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

    <ContentDialog x:Name="PurchaseDialog" Title="Thanh toán" CloseButtonText="Đóng" DefaultButton="None">
        <ScrollViewer MaxHeight="680">
            <StackPanel MinWidth="520" Spacing="16">
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.PaymentMessage, Mode=OneWay}" TextWrapping="Wrap" />
                <ProgressRing HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsPaymentBusy, Mode=OneWay}" />
                <StackPanel x:Name="PaymentOrderPanel" x:Load="{x:Bind ViewModel.HasPaymentOrder, Mode=OneWay}" Spacing="12">
                    <Image Width="240" Height="240" Stretch="Uniform" Source="{x:Bind ViewModel.PaymentQrUrl, Mode=OneWay}" AutomationProperties.Name="Mã QR thanh toán" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Sản phẩm" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.PaymentProductName, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Tổng thanh toán" /><TextBlock Grid.Row="1" Grid.Column="1" FontSize="24" FontWeight="SemiBold" Text="{x:Bind ViewModel.PaymentAmount, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Text="Ngân hàng" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PaymentBank, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Text="Tài khoản" /><TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Consolas" Text="{x:Bind ViewModel.PaymentAccount, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Text="Nội dung chuyển khoản" /><TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.PaymentContent, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Text="Đơn hết hạn" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.PaymentExpiresAt, Mode=OneWay}" />
                    </Grid>
                    <Button HorizontalAlignment="Left" MinHeight="44" Click="OnCopyPaymentContentClicked" Style="{StaticResource AmsSecondaryButtonStyle}" Content="Sao chép nội dung" />
                    <Button HorizontalAlignment="Left" MinHeight="44" IsEnabled="{x:Bind ViewModel.CanCancelPayment, Mode=OneWay}" Click="OnCancelPaymentClicked" Style="{StaticResource AmsSecondaryButtonStyle}" Content="Hủy đơn" />
                </StackPanel>
                <StackPanel x:Name="PaymentProductPanel" x:Load="{x:Bind ViewModel.ShowPaymentProductSelection, Mode=OneWay}" Spacing="12">
                    <ComboBox Header="Chọn gói" ItemsSource="{x:Bind ViewModel.PaymentProducts, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPaymentProduct, Mode=TwoWay}" DisplayMemberPath="Label" MinHeight="44" />
                    <Button HorizontalAlignment="Left" MinHeight="44" IsEnabled="{x:Bind ViewModel.CanCreatePayment, Mode=OneWay}" Click="OnCreatePaymentClicked" Style="{StaticResource AmsPrimaryButtonStyle}" Content="Tạo đơn thanh toán" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </ContentDialog>
    </Grid>
</Page>
