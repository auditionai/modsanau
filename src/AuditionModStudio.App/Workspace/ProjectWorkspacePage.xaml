<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuditionModStudio.App.Workspace.ProjectWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="{StaticResource AmsShellContentPadding}" RowSpacing="{StaticResource AmsSpace16}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="{StaticResource AmsSpace8}">
                <TextBlock
                    x:Name="WorkspaceHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource AmsSectionTitleStyle}"
                    Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource AmsBodyTextStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <ProgressBar
                    AutomationProperties.Name="Workspace loading progress"
                    Maximum="100"
                    Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" />
                <Button
                    AutomationProperties.Name="Cancel workspace loading"
                    Click="OnCancelLoadingClicked"
                    HorizontalAlignment="Left"
                    IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                    Style="{StaticResource AmsSecondaryButtonStyle}">
                    Cancel loading
                </Button>
            </StackPanel>

            <Grid
                x:Name="WorkspaceColumns"
                Grid.Row="1"
                ColumnSpacing="{StaticResource AmsSpace16}"
                RowSpacing="{StaticResource AmsSpace16}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="StackedWorkspaceState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SecondColumn.Width" Value="0" />
                                <Setter Target="ThirdColumn.Width" Value="0" />
                                <Setter Target="PreviewPane.(Grid.Column)" Value="0" />
                                <Setter Target="PreviewPane.(Grid.Row)" Value="1" />
                                <Setter Target="MetadataPane.(Grid.Column)" Value="0" />
                                <Setter Target="MetadataPane.(Grid.Row)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="ThreePaneWorkspaceState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1100" />
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition x:Name="SecondColumn" Width="2*" />
                    <ColumnDefinition x:Name="ThirdColumn" Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="BrowserPane" Style="{StaticResource AmsCardStyle}">
                    <StackPanel Spacing="{StaticResource AmsSpace12}">
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Folders" />
                        <TextBox
                            AutomationProperties.Name="Search textures"
                            MaxLength="256"
                            PlaceholderText="Search name, file, or path"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            AutomationProperties.Name="Texture mapping filter"
                            ItemsSource="{x:Bind ViewModel.MappingFilters}"
                            SelectedItem="{x:Bind ViewModel.MappingFilter, Mode=TwoWay}" />
                        <TreeView
                            x:Name="FolderTree"
                            AutomationProperties.Name="Project texture folders"
                            SelectionChanged="OnTreeSelectionChanged">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLabel}" />
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="PreviewPane"
                    Grid.Column="1"
                    Style="{StaticResource AmsGamingPanelStyle}">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource AmsSpace16}">
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Preview / Editor" />
                        <Border Style="{StaticResource AmsCardStyle}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Spacing="{StaticResource AmsSpace12}">
                                <FontIcon
                                    AutomationProperties.Name="Texture preview placeholder"
                                    FontSize="48"
                                    Glyph="&#xE91B;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource AmsSectionTitleStyle}"
                                    Text="{x:Bind ViewModel.SelectedDisplayName, Mode=OneWay}" />
                                <TextBlock
                                    MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    Style="{StaticResource AmsBodyTextStyle}"
                                    Text="{x:Bind ViewModel.PreviewMessage, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="MetadataPane"
                    Grid.Column="2"
                    Style="{StaticResource AmsCardStyle}">
                    <StackPanel Spacing="{StaticResource AmsSpace12}">
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Metadata / Edit options" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Relative path" />
                        <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.SelectedRelativePath, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Recommended edit mode" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedEditMode, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="Open image editor"
                            IsEnabled="False"
                            Style="{StaticResource AmsPrimaryButtonStyle}">
                            Open image editor
                        </Button>
                        <Button
                            AutomationProperties.Name="Replace texture"
                            IsEnabled="False"
                            Style="{StaticResource AmsSecondaryButtonStyle}">
                            Replace texture
                        </Button>
                        <Button
                            AutomationProperties.Name="Reset texture"
                            IsEnabled="False"
                            Style="{StaticResource AmsSecondaryButtonStyle}">
                            Reset texture
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource AmsStatusBadgeStyle}">
                <Grid
                    x:Name="StatusGrid"
                    ColumnSpacing="{StaticResource AmsSpace16}"
                    RowSpacing="{StaticResource AmsSpace8}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="CompactStatusState">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="StatusThirdColumn.Width" Value="0" />
                                    <Setter Target="StatusFourthColumn.Width" Value="0" />
                                    <Setter Target="FormatStatus.(Grid.Column)" Value="0" />
                                    <Setter Target="FormatStatus.(Grid.Row)" Value="1" />
                                    <Setter Target="StateStatus.(Grid.Column)" Value="1" />
                                    <Setter Target="ValidationStatus.(Grid.Column)" Value="1" />
                                    <Setter Target="ValidationStatus.(Grid.Row)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideStatusState">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="760" />
                                </VisualState.StateTriggers>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="StatusThirdColumn" Width="*" />
                        <ColumnDefinition x:Name="StatusFourthColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="SizeStatus">
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Target size" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedTargetSize, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel x:Name="FormatStatus" Grid.Column="1">
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Format" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedFormat, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel x:Name="StateStatus" Grid.Column="2">
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="State" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedState, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel x:Name="ValidationStatus" Grid.Column="3">
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Validation" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedValidation, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
