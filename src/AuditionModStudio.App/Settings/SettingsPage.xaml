<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AuditionModStudio.App.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer AutomationProperties.Name="Cài đặt ứng dụng và thông tin sản phẩm" HorizontalContentAlignment="Stretch">
        <Grid Padding="{StaticResource AmsShellContentPadding}" RowSpacing="{StaticResource AmsSpace20}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="{StaticResource AmsSpace8}">
            <TextBlock x:Name="SettingsHeading" x:Uid="SettingsHeading" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource AmsPageTitleStyle}" Text="Cài đặt" />
                <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Tùy chỉnh giao diện và xem thông tin ứng dụng." />
            </StackPanel>

            <Grid x:Name="SettingsCards" Grid.Row="1" ColumnSpacing="{StaticResource AmsSpace20}" RowSpacing="{StaticResource AmsSpace20}">
                <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="StackedSettingsState"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="SecondSettingsColumn.Width" Value="0" /><Setter Target="AboutCard.(Grid.Column)" Value="0" /><Setter Target="AboutCard.(Grid.Row)" Value="1" /></VisualState.Setters></VisualState><VisualState x:Name="WideSettingsState"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition x:Name="SecondSettingsColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Border MinHeight="390" Style="{StaticResource AmsGamingPanelStyle}">
                    <StackPanel Spacing="{StaticResource AmsSpace20}">
                        <Border Width="52" Height="52" HorizontalAlignment="Left" Background="{ThemeResource AmsAccentSubtleBrush}" CornerRadius="8"><FontIcon Foreground="{ThemeResource AmsFocusBrush}" FontSize="22" Glyph="&#xE790;" /></Border>
                        <StackPanel Spacing="6"><TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsPageTitleStyle}" Text="Giao diện" /><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Hai chủ đề được thiết kế riêng cho studio sáng tạo; tương phản cao sẽ theo Windows." /></StackPanel>
                        <Border Padding="16" Background="{ThemeResource AmsSurfaceLowBrush}" CornerRadius="{StaticResource AmsRadiusMedium}">
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Style="{StaticResource AmsLabelTextStyle}" Text="Chủ đề giao diện" /><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Đổi chủ đề ngay, không cần khởi động lại." /></StackPanel><ComboBox x:Name="ThemeSelector" Grid.Column="1" AutomationProperties.Name="Chủ đề giao diện" MinWidth="220" MinHeight="44" SelectionChanged="OnThemeSelectionChanged"><ComboBoxItem Content="Creative Daylight" Tag="Light" /><ComboBoxItem Content="Studio Night" Tag="Dark" /><ComboBoxItem Content="Theo Windows" Tag="Default" /></ComboBox></Grid>
                        </Border>
                        <TextBlock AutomationProperties.LiveSetting="Polite" Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ThemeStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border x:Name="AboutCard" Grid.Column="1" Style="{StaticResource AmsCardStyle}">
                    <StackPanel Spacing="{StaticResource AmsSpace16}">
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource AmsSectionTitleStyle}" Text="Giới thiệu" /><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Bộ công cụ sáng tạo Portable dành cho tệp Mod Audition độc lập." /></StackPanel><Border Grid.Column="1" Style="{StaticResource AmsStatusBadgeStyle}"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="x64" /></Border></Grid>
                        <Border Padding="16" Background="{ThemeResource AmsSurfaceLowBrush}" CornerRadius="{StaticResource AmsRadiusMedium}"><Grid ColumnSpacing="12" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Phiên bản" /><TextBlock Grid.Column="1" Text="{x:Bind ProductVersion}" TextWrapping="Wrap" /><TextBlock Grid.Row="1" Style="{StaticResource AmsCaptionTextStyle}" Text="Kiến trúc" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Architecture}" /><TextBlock Grid.Row="2" Style="{StaticResource AmsCaptionTextStyle}" Text="Bản phân phối" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Portable ZIP" TextWrapping="Wrap" /></Grid></Border>
                        <Expander Header="Chẩn đoán &amp; thông tin hệ thống">
                            <StackPanel Padding="0,12,0,0" Spacing="8"><TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Dữ liệu ứng dụng" /><TextBlock Text="LocalApplicationData, Credential Manager, không gian dự án và thư mục xuất do bạn chọn" TextWrapping="Wrap" /><TextBlock Margin="0,8,0,0" Style="{StaticResource AmsBodyTextStyle}" Text="Cấu hình V1 dự kiến" /><TextBlock Text="Windows 10/11 x64 · CPU phổ thông 4 nhân · RAM 8 GB · hỗ trợ đồ họa tích hợp · nên dùng SSD" TextWrapping="Wrap" /><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Khung hiển thị tối thiểu 1366×768 · khung tham chiếu 1920×1080. Cấu hình phần cứng sẽ được chốt ở PLAN 108." TextWrapping="Wrap" /></StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
