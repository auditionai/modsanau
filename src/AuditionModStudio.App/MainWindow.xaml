<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="AuditionModStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Audition AI Mod Studio">
    <Grid Background="{ThemeResource AmsWindowBackgroundBrush}" RequestedTheme="Light">
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid
            x:Name="AppTitleBar"
            Padding="24,0,148,0"
            Background="{ThemeResource AmsPanelBrush}"
            BorderBrush="{ThemeResource AmsCardBorderBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="28" Height="28" VerticalAlignment="Center" Background="{ThemeResource AmsButtonPrimaryBrush}" CornerRadius="6">
                <FontIcon FontSize="15" Foreground="White" Glyph="&#xE790;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                <TextBlock Foreground="{ThemeResource AmsTextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Text="Audition AI" />
                <TextBlock Foreground="{ThemeResource AmsTextSecondaryBrush}" FontSize="14" Text="Mod Studio" />
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Border Padding="10,5" Background="{ThemeResource AmsSurfaceLowBrush}" BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Foreground="{ThemeResource AmsTextSecondaryBrush}" Style="{StaticResource AmsCaptionTextStyle}" Text="PORTABLE · x64" /></Border>
                <Button x:Name="SignOutButton" AutomationProperties.Name="Đăng xuất ứng dụng" Click="OnSignOutClicked" Style="{StaticResource AmsGhostButtonStyle}" Content="Đăng xuất" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <ContentControl x:Name="RootContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
