<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuditionModStudio.App.Editor.ImageEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="{StaticResource AmsShellContentPadding}" RowSpacing="{StaticResource AmsSpace16}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="{StaticResource AmsSpace8}">
                <TextBlock
                    x:Name="EditorHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource AmsSectionTitleStyle}"
                    Text="Crop / Resize Canvas" />
                <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.TextureName, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource AmsBodyTextStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AmsSpace8}">
                    <ProgressRing
                        AutomationProperties.Name="Selected texture loading"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Cancel selected texture loading"
                        Click="OnCancelClicked"
                        IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                        Style="{StaticResource AmsSecondaryButtonStyle}">
                        Cancel loading
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid
                x:Name="EditorLayout"
                Grid.Row="1"
                ColumnSpacing="{StaticResource AmsSpace16}"
                RowSpacing="{StaticResource AmsSpace16}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="StackedEditorState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="EditorControlsColumn.Width" Value="0" />
                                <Setter Target="EditorControls.(Grid.Column)" Value="0" />
                                <Setter Target="EditorControls.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="WideEditorState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1000" />
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition x:Name="EditorControlsColumn" Width="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource AmsGamingPanelStyle}">
                    <Grid RowSpacing="{StaticResource AmsSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="520" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="{StaticResource AmsSpace12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Interactive target frame" />
                            <Border Grid.Column="1" Style="{StaticResource AmsStatusBadgeStyle}">
                                <TextBlock
                                    AutomationProperties.Name="Exact DDS target dimensions"
                                    Text="{x:Bind ViewModel.TargetDimensions, Mode=OneWay}" />
                            </Border>
                        </Grid>
                        <Canvas
                            x:Name="EditorCanvas"
                            Grid.Row="1"
                            AutomationProperties.HelpText="Drag to pan. Use the mouse wheel or zoom slider to zoom."
                            AutomationProperties.Name="Interactive crop and resize canvas"
                            Background="{ThemeResource AmsCardBrush}"
                            PointerMoved="OnCanvasPointerMoved"
                            PointerPressed="OnCanvasPointerPressed"
                            PointerReleased="OnCanvasPointerReleased"
                            PointerWheelChanged="OnCanvasPointerWheelChanged"
                            SizeChanged="OnCanvasSizeChanged">
                            <Image
                                x:Name="EditorImage"
                                AutomationProperties.Name="Selected texture preview"
                                Stretch="Fill" />
                            <Border
                                x:Name="TargetFrame"
                                AutomationProperties.Name="Exact DDS target frame"
                                BorderBrush="{ThemeResource AmsFocusBrush}"
                                BorderThickness="2"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="CropFrame"
                                AutomationProperties.Name="Crop selection frame"
                                BorderBrush="{ThemeResource AmsWarningBrush}"
                                BorderThickness="2"
                                IsHitTestVisible="False" />
                        </Canvas>
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource AmsBodyTextStyle}"
                            Text="Target frame · cyan outline   Crop area · amber outline   Drag canvas · pan" />
                    </Grid>
                </Border>

                <Border
                    x:Name="EditorControls"
                    Grid.Column="1"
                    Style="{StaticResource AmsCardStyle}">
                    <StackPanel Spacing="{StaticResource AmsSpace12}">
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Resize controls" />
                        <ComboBox
                            AutomationProperties.Name="Resize mode"
                            DisplayMemberPath="Label"
                            Header="Mode"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Modes}"
                            SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}" />
                        <TextBlock Text="Zoom" />
                        <Slider
                            x:Name="ZoomSlider"
                            AutomationProperties.Name="Canvas zoom"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            Maximum="8"
                            Minimum="0.1"
                            StepFrequency="0.1"
                            Value="1"
                            ValueChanged="OnZoomChanged" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.PanSummary, Mode=OneWay}" />
                        <Grid ColumnSpacing="{StaticResource AmsSpace8}" RowSpacing="{StaticResource AmsSpace8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Pan canvas up"
                                Click="OnPanClicked"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Style="{StaticResource AmsSecondaryButtonStyle}"
                                Tag="up">↑</Button>
                            <Button
                                Grid.Row="1"
                                AutomationProperties.Name="Pan canvas left"
                                Click="OnPanClicked"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Style="{StaticResource AmsSecondaryButtonStyle}"
                                Tag="left">←</Button>
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.Name="Pan canvas down"
                                Click="OnPanClicked"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Style="{StaticResource AmsSecondaryButtonStyle}"
                                Tag="down">↓</Button>
                            <Button
                                Grid.Row="1"
                                Grid.Column="2"
                                AutomationProperties.Name="Pan canvas right"
                                Click="OnPanClicked"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Style="{StaticResource AmsSecondaryButtonStyle}"
                                Tag="right">→</Button>
                        </Grid>
                        <Button
                            AutomationProperties.Name="Reset canvas transform"
                            Click="OnResetClicked"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            Style="{StaticResource AmsSecondaryButtonStyle}">
                            Reset zoom / pan / crop
                        </Button>
                        <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Crop percentages" />
                        <Grid ColumnSpacing="{StaticResource AmsSpace8}" RowSpacing="{StaticResource AmsSpace8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <NumberBox x:Name="CropX" Header="Left %" Maximum="99" Minimum="0" Value="0" />
                            <NumberBox x:Name="CropY" Grid.Column="1" Header="Top %" Maximum="99" Minimum="0" Value="0" />
                            <NumberBox x:Name="CropWidth" Grid.Row="1" Header="Width %" Maximum="100" Minimum="0.01" Value="100" />
                            <NumberBox x:Name="CropHeight" Grid.Row="1" Grid.Column="1" Header="Height %" Maximum="100" Minimum="0.01" Value="100" />
                        </Grid>
                        <Button
                            AutomationProperties.Name="Update crop frame"
                            Click="OnUpdateCropClicked"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            Style="{StaticResource AmsPrimaryButtonStyle}">
                            Update crop frame
                        </Button>
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.CropSummary, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Apply is intentionally unavailable until PLAN 47 validation and atomic replacement." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource AmsStatusBadgeStyle}">
                <Grid ColumnSpacing="{StaticResource AmsSpace16}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Target" />
                        <TextBlock Text="{x:Bind ViewModel.TargetDimensions, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="Mode" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedMode.Label, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="State" />
                        <TextBlock Text="Preview only · no files changed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
