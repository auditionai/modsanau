<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuditionModStudio.App.Editor.ImageEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource AmsShellContentPadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Daylight contextual command header. -->
        <Border Padding="20,14" Style="{StaticResource AmsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="EditorHeading"
                        x:Uid="EditorHeading"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource AmsPageTitleStyle}"
                        Text="Trình chỉnh sửa ảnh" />
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.TextureName, Mode=OneWay}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AmsStatusBadgeStyle}">
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.TargetDimensions, Mode=OneWay}" />
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Border Style="{StaticResource AmsStatusBadgeStyle}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Foreground="{ThemeResource AmsFocusBrush}" FontSize="12" Glyph="&#xE71E;" /><TextBlock x:Name="ZoomBadgeText" FontFamily="Cascadia Mono" FontSize="12" Text="100%" /></StackPanel></Border>
                    <Button AutomationProperties.Name="Thu phóng một trên một" Click="OnOneToOneClicked" IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" Style="{StaticResource AmsGhostButtonStyle}">1:1</Button>
                    <ProgressRing
                        AutomationProperties.Name="Đang tải Texture đã chọn"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Hủy tải Texture đã chọn"
                        Click="OnCancelClicked"
                        IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                        Style="{StaticResource AmsSecondaryButtonStyle}">
                        Hủy tải
                    </Button>
                    <Button
                        AutomationProperties.Name="Tải ảnh thay thế"
                        Click="OnImportReplacementClicked"
                        Style="{StaticResource AmsSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE898;" />
                            <TextBlock Text="Tải ảnh thay thế" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="Đặt lại khung chỉnh sửa"
                        Click="OnResetClicked"
                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                        Style="{StaticResource AmsGhostButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            <TextBlock Text="Đặt lại" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.HelpText="Kiểm tra, mã hóa và thay thế an toàn chỉ Texture đang chọn trong dự án."
                        AutomationProperties.Name="Áp dụng Texture đã chọn"
                        Click="OnApplyClicked"
                        IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                        Style="{StaticResource AmsPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE8FB;" />
                            <TextBlock Text="Áp dụng Texture" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="Hủy áp dụng Texture"
                        Click="OnCancelApplyClicked"
                        IsEnabled="{x:Bind ViewModel.CanCancelApply, Mode=OneWay}"
                        Style="{StaticResource AmsSecondaryButtonStyle}">
                        Hủy
                    </Button>
                    <Button AutomationProperties.Name="Tao anh bang AI tu Texture dang chon" Click="OnCreateWithAiClicked" Style="{StaticResource AmsSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE945;" />
                            <TextBlock Text="Tao bang AI" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Editor Layout: Dominant Canvas (Left) + Right Contextual Inspector -->
        <Grid
            x:Name="EditorLayout"
            Grid.Row="1"
            ColumnSpacing="16"
            RowSpacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="StackedEditorState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="EditorControlsColumn.Width" Value="0" />
                            <Setter Target="EditorControls.(Grid.Column)" Value="0" />
                            <Setter Target="EditorControls.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideEditorState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition x:Name="EditorControlsColumn" Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- DOMINANT CANVAS VIEWPORT -->
            <Border Style="{StaticResource AmsEditorSurfaceStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Khung xem chỉnh sửa" />
                            <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Chỉnh sửa ảnh nguồn theo đúng khung DDS đích" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource AmsStatusBadgeStyle}">
                            <TextBlock
                                AutomationProperties.Name="Kích thước đích DDS chính xác"
                                Style="{StaticResource AmsCaptionTextStyle}"
                                Text="{x:Bind ViewModel.TargetDimensions, Mode=OneWay}" />
                        </Border>
                    </Grid>

                    <Canvas
                        x:Name="EditorCanvas"
                        Grid.Row="1"
                        MinHeight="480"
                        AutomationProperties.HelpText="Kéo để di chuyển. Dùng con lăn chuột hoặc thanh Thu phóng để thay đổi tỷ lệ."
                        AutomationProperties.Name="Khung cắt và đổi kích thước tương tác"
                        Background="{ThemeResource AmsCanvasBrush}"
                        PointerMoved="OnCanvasPointerMoved"
                        PointerPressed="OnCanvasPointerPressed"
                        PointerReleased="OnCanvasPointerReleased"
                        PointerWheelChanged="OnCanvasPointerWheelChanged"
                        SizeChanged="OnCanvasSizeChanged">
                        <Image
                            x:Name="EditorImage"
                            AutomationProperties.Name="Xem trước Texture đã chọn"
                            Stretch="Fill" />
                        <Border
                            x:Name="TargetFrame"
                            AutomationProperties.Name="Khung đích DDS chính xác"
                            BorderBrush="{ThemeResource AmsFocusBrush}"
                            BorderThickness="2"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="CropFrame"
                            AutomationProperties.Name="Vùng cắt đã chọn"
                            BorderBrush="{ThemeResource AmsWarningBrush}"
                            BorderThickness="2"
                            IsHitTestVisible="False" />
                    </Canvas>

                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource AmsCaptionTextStyle}"
                            Text="Khung đích · viền xanh Cyan  |  Vùng cắt · viền vàng  |  Kéo chuột · di chuyển khung" />
                        <TextBlock
                            Grid.Column="1"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource AmsCaptionTextStyle}"
                            Text="{x:Bind ViewModel.ApplyStatus, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT CONTEXTUAL INSPECTOR (Co gọn, sạch sẽ) -->
            <ScrollViewer
                x:Name="EditorControls"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Section 1: Crop & Resize Options -->
                    <Border Style="{StaticResource AmsCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource AmsSectionTitleStyle}" Text="Cắt &amp; đổi kích thước" />
                            <ComboBox
                                AutomationProperties.Name="Chế độ đổi kích thước"
                                DisplayMemberPath="Label"
                                Header="Chế độ"
                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Modes}"
                                SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource AmsBodyTextStyle}" Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}" />

                            <TextBlock Style="{StaticResource AmsLabelTextStyle}" Text="Thu phóng" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="ZoomSlider"
                                    AutomationProperties.Name="Thu phóng khung chỉnh sửa"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Maximum="8"
                                    ValueChanged="OnZoomChanged" />
                                <NumberBox
                                    x:Name="ZoomValueBox"
                                    Grid.Column="1"
                                    Width="86"
                                    Header=""
                                    Minimum="0.1"
                                    Maximum="8"
                                    SmallChange="0.001"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="OnZoomValueChanged" />
                            </Grid>

                            <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.PanSummary, Mode=OneWay}" />
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Di chuyển khung lên trên"
                                    Click="OnPanClicked"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Style="{StaticResource AmsIconButtonStyle}"
                                    Tag="up">↑</Button>
                                <Button
                                    Grid.Row="1"
                                    AutomationProperties.Name="Di chuyển khung sang trái"
                                    Click="OnPanClicked"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Style="{StaticResource AmsIconButtonStyle}"
                                    Tag="left">←</Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Di chuyển khung xuống dưới"
                                    Click="OnPanClicked"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Style="{StaticResource AmsIconButtonStyle}"
                                    Tag="down">↓</Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    AutomationProperties.Name="Di chuyển khung sang phải"
                                    Click="OnPanClicked"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Style="{StaticResource AmsIconButtonStyle}"
                                    Tag="right">→</Button>
                            </Grid>

                            <TextBlock Style="{StaticResource AmsLabelTextStyle}" Text="Vùng cắt (%)" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox x:Name="CropX" Header="Trái %" Maximum="99" Minimum="0" Value="0" />
                                <NumberBox x:Name="CropY" Grid.Column="1" Header="Trên %" Maximum="99" Minimum="0" Value="0" />
                                <NumberBox x:Name="CropWidth" Grid.Row="1" Header="Chiếu rộng %" Maximum="100" Value="100" />
                                <NumberBox x:Name="CropHeight" Grid.Row="1" Grid.Column="1" Header="Chiều cao %" Maximum="100" Value="100" />
                            </Grid>
                            <Button
                                AutomationProperties.Name="Cập nhật vùng cắt"
                                Click="OnUpdateCropClicked"
                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                Style="{StaticResource AmsSecondaryButtonStyle}">
                                Cập nhật vùng cắt
                            </Button>
                            <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.CropSummary, Mode=OneWay}" />
                            <ProgressBar
                                AutomationProperties.Name="Tiến trình áp dụng Texture"
                                Maximum="100"
                                Minimum="0"
                                Value="{x:Bind ViewModel.ApplyProgress, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Khu vực kiểm tra so sánh trước và sau. -->
                    <Expander Header="So sánh trước / sau" IsExpanded="False">
                        <StackPanel Padding="0,12,0,0" Spacing="12">
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource AmsCaptionTextStyle}"
                                Text="{x:Bind ViewModel.AfterPreviewStatus, Mode=OneWay}" />
                            <ProgressRing
                                AutomationProperties.Name="Đang tạo bản xem trước Sau"
                                IsActive="{x:Bind ViewModel.IsAfterPreviewLoading, Mode=OneWay}" />
                            <ComboBox
                                AutomationProperties.Name="Chế độ so sánh"
                                DisplayMemberPath="Label"
                                Header="Chế độ"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.CompareModes}"
                                SelectedItem="{x:Bind ViewModel.SelectedCompareMode, Mode=TwoWay}" />
                            <CheckBox
                                x:Name="CheckerboardToggle"
                                AutomationProperties.Name="Hiển thị nền caro Alpha"
                                Click="OnCheckerboardClicked"
                                Content="Nền caro Alpha"
                                IsChecked="True"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Thu phóng so sánh" />
                            <Slider
                                x:Name="CompareZoomSlider"
                                AutomationProperties.Name="Thu phóng chung cho ảnh Trước và Sau"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Maximum="8"
                                ValueChanged="OnCompareZoomChanged" />

                            <Grid x:Name="SideBySideCompare" Height="220">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AmsRadiusSmall}">
                                    <Grid x:Name="BeforeSideViewport" SizeChanged="OnCompareSurfaceSizeChanged">
                                        <Grid x:Name="BeforeSideCheckerboard" IsHitTestVisible="False" />
                                        <Canvas x:Name="BeforeSideCanvas" Background="Transparent" PointerMoved="OnComparePointerMoved" PointerPressed="OnComparePointerPressed" PointerReleased="OnComparePointerReleased" PointerWheelChanged="OnComparePointerWheelChanged">
                                            <Image x:Name="BeforeSideImage" AutomationProperties.Name="Ảnh Trước của phiên" Stretch="Fill" />
                                        </Canvas>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource AmsStatusBadgeStyle}" VerticalAlignment="Top"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Trước" /></Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AmsRadiusSmall}">
                                    <Grid x:Name="AfterSideViewport" SizeChanged="OnCompareSurfaceSizeChanged">
                                        <Grid x:Name="AfterSideCheckerboard" IsHitTestVisible="False" />
                                        <Canvas x:Name="AfterSideCanvas" Background="Transparent" PointerMoved="OnComparePointerMoved" PointerPressed="OnComparePointerPressed" PointerReleased="OnComparePointerReleased" PointerWheelChanged="OnComparePointerWheelChanged">
                                            <Image x:Name="AfterSideImage" AutomationProperties.Name="Bản xem trước Sau" Stretch="Fill" />
                                        </Canvas>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource AmsStatusBadgeStyle}" VerticalAlignment="Top"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Sau" /></Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="SliderCompare" Spacing="8" Visibility="Collapsed">
                                <Border BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AmsRadiusSmall}">
                                    <Grid x:Name="SliderViewport" Height="220" SizeChanged="OnCompareSurfaceSizeChanged">
                                        <Grid x:Name="SliderCheckerboard" IsHitTestVisible="False" />
                                        <Canvas x:Name="BeforeSliderLayer" Background="Transparent" PointerMoved="OnComparePointerMoved" PointerPressed="OnComparePointerPressed" PointerReleased="OnComparePointerReleased" PointerWheelChanged="OnComparePointerWheelChanged">
                                            <Image x:Name="BeforeSliderImage" AutomationProperties.Name="Ảnh Trước dưới thanh chia so sánh" Stretch="Fill" />
                                        </Canvas>
                                        <Canvas x:Name="AfterSliderLayer" IsHitTestVisible="False">
                                            <Image x:Name="AfterSliderImage" AutomationProperties.Name="Ảnh Sau được cắt theo thanh chia so sánh" Stretch="Fill" />
                                        </Canvas>
                                        <Canvas IsHitTestVisible="False">
                                            <Border x:Name="SliderDivider" Background="{ThemeResource AmsFocusBrush}" Width="3" />
                                            <Border HorizontalAlignment="Left" Style="{StaticResource AmsStatusBadgeStyle}" VerticalAlignment="Top"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Trước" /></Border>
                                            <Border HorizontalAlignment="Right" Style="{StaticResource AmsStatusBadgeStyle}" VerticalAlignment="Top"><TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Sau" /></Border>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Slider
                                    x:Name="CompareDividerSlider"
                                    AutomationProperties.HelpText="Dùng phím mũi tên trái và phải để di chuyển thanh chia Trước và Sau."
                                    AutomationProperties.Name="Thanh chia so sánh Trước và Sau"
                                    IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                    Maximum="1"
                                    Minimum="0"
                                    ValueChanged="OnCompareDividerChanged" />
                            </StackPanel>

                            <StackPanel x:Name="ToggleCompare" Spacing="8" Visibility="Collapsed">
                                <ToggleSwitch
                                    x:Name="BeforeAfterToggle"
                                    AutomationProperties.Name="Hiển thị ảnh Trước hoặc Sau"
                                    Header="Ảnh đang hiển thị"
                                    IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                    IsOn="True"
                                    OffContent="Trước"
                                    OnContent="Sau"
                                    Toggled="OnBeforeAfterToggled" />
                                <Border BorderBrush="{ThemeResource AmsCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AmsRadiusSmall}">
                                    <Grid x:Name="ToggleViewport" Height="220" SizeChanged="OnCompareSurfaceSizeChanged">
                                        <Grid x:Name="ToggleCheckerboard" IsHitTestVisible="False" />
                                        <Canvas x:Name="ToggleCanvas" Background="Transparent" PointerMoved="OnComparePointerMoved" PointerPressed="OnComparePointerPressed" PointerReleased="OnComparePointerReleased" PointerWheelChanged="OnComparePointerWheelChanged">
                                            <Image x:Name="ToggleImage" AutomationProperties.Name="Ảnh so sánh Trước hoặc Sau hiện tại" Stretch="Fill" />
                                        </Canvas>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource AmsStatusBadgeStyle}" VerticalAlignment="Top"><TextBlock x:Name="ToggleStateLabel" Style="{StaticResource AmsCaptionTextStyle}" Text="Sau" /></Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button AutomationProperties.Name="Di chuyển vùng so sánh sang trái" Click="OnComparePanClicked" IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" Style="{StaticResource AmsIconButtonStyle}" Tag="left">←</Button>
                                <Button AutomationProperties.Name="Di chuyển vùng so sánh lên trên" Click="OnComparePanClicked" IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" Style="{StaticResource AmsIconButtonStyle}" Tag="up">↑</Button>
                                <Button AutomationProperties.Name="Di chuyển vùng so sánh xuống dưới" Click="OnComparePanClicked" IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" Style="{StaticResource AmsIconButtonStyle}" Tag="down">↓</Button>
                                <Button AutomationProperties.Name="Di chuyển vùng so sánh sang phải" Click="OnComparePanClicked" IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" Style="{StaticResource AmsIconButtonStyle}" Tag="right">→</Button>
                                <Button AutomationProperties.Name="Đặt lại khung xem so sánh" Click="OnCompareCameraResetClicked" IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" Style="{StaticResource AmsGhostButtonStyle}">Đặt lại</Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.ComparePanSummary, Mode=OneWay}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource AmsStatusBadgeStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Kích thước đích:" />
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.TargetDimensions, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Chế độ:" />
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="{x:Bind ViewModel.SelectedMode.Label, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Trạng thái:" />
                    <TextBlock Style="{StaticResource AmsCaptionTextStyle}" Text="Chỉ xem trước · chưa thay đổi tệp" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
